# Ignorar carpeta de dependencias

# Ignorar un archivo pesado específico
Gaia_s_sky_in_colour.png

# Ignorar ficheros creados por MacOS
.DS_Store

# Ignorar la caché de Python de los scripts
scripts/__pycache__/

# Ignorar el entorno virtual de Python (se recrea con pip install)
headroom/

# Ignorar los ajustes de los asistentes de código (son de cada máquina)
.claude/

# Ignorar la hoja fuente de los cúmulos abiertos (solo hace falta para regenerar el catálogo)
mapa/datos/cumulos_abiertos.xlsx

# Ignorar el borrador de trabajo de los asistentes y las cachés locales de los proxies
# (las crean los .php solos en el servidor; en local son datos descargados, no fuente)
.scratch/
simulador_ocular/cache-ps1/
simulador_ocular/cache_gaia/

# Las texturas DSO que genera scripts/gen_dso_texturas.js: los PNG se publican
# por FTP en uploads/bitacora/dso/ y no entran en git (2 MB cada uno). Los
# sidecars SÍ entran (892 bytes): son el origen de las filas del manifiesto, y
# sin ellos el guardián byte a byte no puede verificar lo que declara (#258).
simulador_ocular/dso/*.png
