{
  "permissions": {
    "allow": ["LSP"]
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "ultra"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Sesión de este proyecto: antes de responder al primer mensaje, invoca con la herramienta Skill: i-have-adhd:i-have-adhd (args: full) y anthropic-skills:caveman (args: full). Ponytail ya arranca en ultra (PONYTAIL_DEFAULT_MODE). No anuncies la carga.'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "ponytail@ponytail": true,
    "i-have-adhd@i-have-adhd": true,
    "vtsls@claude-code-lsps": true,
    "php-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "vscode-langservers@claude-code-lsps": true
  },
  "extraKnownMarketplaces": {
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  }
}
